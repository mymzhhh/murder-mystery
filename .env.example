# DeepSeek API 配置
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Agnes LLM 配置（AI 玩家智能行为；不配置时 AI 玩家回退规则引擎）
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# 服务端口
PORT=3000

# 默认模型
DEFAULT_MODEL=deepseek-v4-flash

# Redis 连接（Docker 内部使用服务名 redis）
REDIS_URL=redis://localhost:6379

# Redis 连接池大小 (可选, 默认 4)
# REDIS_POOL_SIZE=4

# PostgreSQL 连接（Docker 内部使用服务名 postgres）
DATABASE_URL=postgresql://murder:murder123@localhost:5432/murder_mystery

# 管理员密码 (可选, 默认 admin123)
# ⚠ 生产环境（NODE_ENV=production）不设置这一项会直接拒绝启动 ——
#   否则一个绑在 0.0.0.0 的部署，管理员口令就是 admin123，等于没有鉴权。
# 设置后它是管理员口令的唯一来源：与已存在的 admin 账号不一致时会自动轮换并撤销旧令牌。
# ADMIN_PASSWORD=<32位随机串>

# 跨域来源（可选，默认 "*" 即不限制）
# 开放到公网时填实际访问来源（逗号分隔）。配了它之后，纯 WebSocket 握手也会校验 Origin。
# CORS_ORIGIN=https://your-domain.com

# 口令哈希迭代次数（默认 210000，OWASP 对 PBKDF2-HMAC-SHA512 的建议值）
# PBKDF2_ITERATIONS=210000

# ===== 房间生命周期 =====
# 房间最大存活时间（小时）。超过后无法再加入，并由后台扫描器删除。
# 默认 6 小时：足够覆盖一局剧本杀（1~3 小时），又不会让房间过夜堆积。
# ROOM_MAX_LIFETIME_HOURS=6
# 一个玩家都没有的房间超过多少分钟就回收（覆盖"建了没玩"与"人全走光"）
# ROOM_ABANDONED_MINUTES=30
# 扫描间隔（分钟）
# ROOM_SWEEP_INTERVAL_MIN=10

# ===== 阶段推进 / 挂机踢出 =====
# 全员就绪后等待多少秒自动推进（默认 10）
# ALL_READY_SECONDS=10
# 只差一个人就绪时的倒计时秒数，到点自动推进（默认 60）。原来是干等 10 分钟。
# PARTIAL_READY_SECONDS=60
# 阶段兜底上限（分钟，默认 10）：无论有没有人点准备，到点都会推进，防止永久卡住
# PHASE_MAX_WAIT_MIN=10
# 真人玩家断线/挂机超过多少分钟就踢出，并由 AI 接管其角色继续游戏（默认 5）。
# 只有在房里还有其他真人玩家时才会接管；否则整个房间直接回收。
# AFK_KICK_MIN=5

# ===== LLM 调用闸门 =====
# 同时发往模型的请求上限（默认 6）。调大能让 AI 更快开口，但更易触发网关限流。
# LLM_MAX_CONCURRENCY=6
# 后台 AI 行为的硬超时（毫秒，默认 45000）。到点放弃并回退规则引擎，避免整桌干等。
# LLM_TIMEOUT_MS=45000
