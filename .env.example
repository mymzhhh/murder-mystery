# DeepSeek API 配置
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Agnes LLM 配置（AI 玩家智能行为；不配置时 AI 玩家回退规则引擎）
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# 服务端口
PORT=3000

# 默认模型
DEFAULT_MODEL=deepseek-v4-flash

# Redis 连接（Docker 内部使用服务名 redis）
REDIS_URL=redis://localhost:6379

# Redis 连接池大小 (可选, 默认 4)
# REDIS_POOL_SIZE=4

# PostgreSQL 连接（Docker 内部使用服务名 postgres）
DATABASE_URL=postgresql://murder:murder123@localhost:5432/murder_mystery

# 管理员密码 (可选, 默认 admin123)
# ADMIN_PASSWORD=admin123
