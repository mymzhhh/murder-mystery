# DeepSeek API 配置
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Agnes LLM 配置（AI 玩家智能行为；不配置时 AI 玩家回退规则引擎）
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# 服务端口
PORT=3000

# 默认模型
DEFAULT_MODEL=deepseek-v4-flash

# Redis 连接（Docker 内部使用服务名 redis）
REDIS_URL=redis://localhost:6379

# Redis 连接池大小 (可选, 默认 4)
# REDIS_POOL_SIZE=4

# PostgreSQL 连接（Docker 内部使用服务名 postgres）
DATABASE_URL=postgresql://murder:murder123@localhost:5432/murder_mystery

# 管理员密码 (可选, 默认 admin123)
# ADMIN_PASSWORD=admin123

# ===== 房间生命周期 =====
# 房间最大存活时间（小时）。超过后无法再加入，并由后台扫描器删除。
# 默认 6 小时：足够覆盖一局剧本杀（1~3 小时），又不会让房间过夜堆积。
# ROOM_MAX_LIFETIME_HOURS=6
# 一个玩家都没有的房间超过多少分钟就回收（覆盖"建了没玩"与"人全走光"）
# ROOM_ABANDONED_MINUTES=30
# 扫描间隔（分钟）
# ROOM_SWEEP_INTERVAL_MIN=10

# ===== LLM 调用闸门 =====
# 同时发往模型的请求上限（默认 6）。调大能让 AI 更快开口，但更易触发网关限流。
# LLM_MAX_CONCURRENCY=6
# 后台 AI 行为的硬超时（毫秒，默认 45000）。到点放弃并回退规则引擎，避免整桌干等。
# LLM_TIMEOUT_MS=45000
